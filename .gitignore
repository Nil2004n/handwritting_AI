# Gradle build outputs and caches.
.gradle/
build/
# Pinned model binaries + pairing configs (reproduced by tools/download-models.sh).
models/*.onnx
models/*.yml
# Local overrides.
local.properties

# Private local evaluation cases (personal images + transcriptions).
# The committed manifest is eval/cases.tsv; put private cases in
# eval-local/cases.tsv (same format, never committed).
eval-local/

# Python bytecode from tools/xcheck
__pycache__/
*.pyc

# User projects and local exports contain private images/text: never commit them.
*.nbai
projects-local/
exports-local/

# Generated release distributions and archives (build output; produced by ./gradlew dist / package)
linux-dist/
win-dist/
release-output/
